{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Databricks: Sync app",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\sync_databricks_app.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Databricks: Watch app sync",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\sync_databricks_app.ps1",
        "-Watch"
      ],
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Streamlit: Run app.py",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m streamlit run app.py",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Python: Run Current File",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe ${file}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}










