# TC Copilot — Configuração
# Copie este arquivo para .env e preencha com seus valores

# Chave da API OpenAI (obrigatória para análise inteligente)
OPENAI_API_KEY=sk-sua-chave-aqui

# Modelo LLM (opcional, default: gpt-4o-mini)
# Opções: gpt-4o-mini, gpt-4o, gpt-4.1-mini, gpt-4.1
# LLM_MODEL=gpt-4o-mini

# Idioma do relatório (opcional, default: pt-BR)
# Opções: pt-BR, en
# REPORT_LANGUAGE=pt-BR
