# ═══════════════════════════════════════════════════════════════
#  SCI — Stellantis Cost Intelligence
#  Copie este arquivo para .env e preencha com seus valores.
#  NUNCA commite o .env real!
# ═══════════════════════════════════════════════════════════════

# ── Feature Flags ──────────────────────────────────────────────
# Backends: "local" (parquet) | "snowflake"
# SCI_DATA_BACKEND=local

# Email: "graph" | "smtp"
# SCI_EMAIL_BACKEND=graph

# LLM: "openai" | "azure_openai" | "databricks"
# SCI_LLM_PROVIDER=openai

# Scheduler: "apscheduler" | "databricks_jobs"
# SCI_SCHEDULER=apscheduler

# ── OpenAI ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-sua-chave-aqui

# Modelo LLM (opcional, default: gpt-4o-mini)
# Opções: gpt-4o-mini, gpt-4o, gpt-4.1-mini, gpt-4.1
# LLM_MODEL=gpt-4o-mini

# Idioma do relatório (opcional, default: pt-BR)
# Opções: pt-BR, en
# REPORT_LANGUAGE=pt-BR

# ── Azure OpenAI (se SCI_LLM_PROVIDER=azure_openai) ───────────
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=

# ── Snowflake (se SCI_DATA_BACKEND=snowflake) ─────────────────
# SNF_ACCOUNT=rr67688.north-europe.azure
# SNF_USER=U235107@INETPSA.COM
# SNF_WAREHOUSE=WH_LAB_FIN
# SNF_DATABASE=DB_BL_FIN
# SNF_SCHEMA=SCI_CURATED
# SNF_ROLE=ZSNF.FINdtsana
# SNF_PRIVATE_KEY=
# SNF_PASSWORD=  # fallback — prefira key-pair

# ── Microsoft Graph API (email) ───────────────────────────────
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER_EMAIL=

# ── Dados compartilhados (override de pasta local) ────────────
# SCI_SHARED_DATA_ROOT=
